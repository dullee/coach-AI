# Copy this file to .env (same folder) and fill in the keys you have.
# .env is gitignored and read automatically by every backend command and the app.
# Variables set in the terminal take priority over this file.

# Coaching model keys (one is enough)
POLLINATIONS_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional settings
# COACH_BACKEND=pollinations          # claude | gemini | pollinations | local
# COACH_LOCAL_MODEL=coach             # Ollama model name for the fine-tuned coach
